# Copy to .env and fill in — .env itself is gitignored, never commit it.
#
# Optional: only needed if you're overriding the default cEOS credentials
# that containerlab already bakes into nornir-simple-inventory.yml. See
# automation/nornir/README.md "The teaching moment on secrets" for how to
# wire this into a script with python-dotenv.
NORNIR_USERNAME=admin
NORNIR_PASSWORD=admin
