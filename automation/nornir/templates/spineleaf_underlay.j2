! Generated by Nornir + Jinja2 — automation/nornir/templates/spineleaf_underlay.j2
! Role: {{ host.data.role }}
!
ip routing
!
{% for intf in host.data.interfaces %}
interface {{ intf.name }}
   description {{ intf.description }}
   no switchport
   ip address {{ intf.ip }}
   ip ospf network point-to-point
!
{% endfor %}
interface Loopback0
   description underlay_router_id
   ip address {{ host.data.loopback }}
!
router ospf 100
   router-id {{ host.data.router_id }}
   network 10.0.0.0/8 area 0.0.0.0
   max-lsa 12000
!
